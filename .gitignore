.claude/
Backup/

# Workbench cache / build artifacts — regenerated on import
*.log
*.tmp
*.txo
*.edds
*.xob
resourceDatabase.rdb

# Blender autosave backups
*.blend1

# Enfusion MCP handler — installed automatically by wb_launch, cleaned before publishing
Scripts/WorkbenchGame/EnfusionMCP/

# Raw source assets — retain locally, don't commit (CGTrader / Sketchfab
# license considerations: royalty-free licenses forbid redistributing the
# raw source files; the mod ships compiled .xob artifacts via the Workshop
# package instead).
3d models import/
*.fbx
*.blend
Models/**/_workfiles/

# Art assets — not needed by contributors; the Workshop package ships the
# compiled versions. Models/ holds .xob/.emat/.meta, Textures/ the source
# PNGs and their import settings.
Models/
Textures/

# Workbench project file — local to each checkout (mod GUID, dependencies,
# resource registrations).
*.gproj

# Documentation lives on the project website, not in the repo
docs/
